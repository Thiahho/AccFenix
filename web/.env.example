# URL de la API .NET. API_URL se usa desde el servidor Next; NEXT_PUBLIC_API_URL desde el navegador.
API_URL=http://localhost:5080
NEXT_PUBLIC_API_URL=http://localhost:5080

# Clave compartida con la API (TrustedWeb__Key, mínimo 32 caracteres). Con ella la web le informa la IP del
# visitante y el límite de intentos de login se cuenta por visitante. Solo servidor: nunca NEXT_PUBLIC_.
API_TRUSTED_KEY=dev-only-trusted-web-key-0123456789abcdef

# Marca y URL pública (metadata, sitemap)
NEXT_PUBLIC_BRAND_NAME=Fénix
NEXT_PUBLIC_SITE_URL=http://localhost:3000
